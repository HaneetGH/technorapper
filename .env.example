# Copy the keys you need into your environment.
# Leave FTP_PASSWORD empty here. Export the real value in the shell
# or a secret store. Never commit it and never paste it into this file.

FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=user@example.com
FTP_SECURE=true
FTP_REMOTE_PATH=/
FTP_PASSWORD=
SITE_URL=http://example.com
